{
  "name": "mcu-trading-terminal",
  "version": "1.0.0",
  "description": "MCU Wargame Trading Terminal — Bloomberg-style futures trading simulation for Professional Military Education",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "cd client && npx vite --host",
    "dev:server": "npx tsx watch server/index.ts",
    "build": "cd client && npx vite build",
    "start": "npx tsx server/index.ts",
    "build:server": "echo 'Server runs via tsx'",
    "build:all": "npm run build",
    "postinstall": "cd client && npm install"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "cors": "^2.8.5",
    "express": "^4.21.1",
    "socket.io": "^4.8.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "yahoo-finance2": "^3.13.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "concurrently": "^9.1.0"
  }
}
